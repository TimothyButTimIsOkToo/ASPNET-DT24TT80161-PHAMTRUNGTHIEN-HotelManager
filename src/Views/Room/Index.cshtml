@model IEnumerable<HotelManager.Models.Room>

@{
    ViewData["Title"] = "All Rooms";
}

<div class="container mt-4">
    <h2>Hotel Rooms Dashboard</h2>
    <p>Here is a list of all rooms currently saved in the SQL Express database.</p>
    
    <a asp-action="Create" class="btn btn-success mb-3">Add New Room</a>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Room Number</th>
                <th>Bed Type</th>
                <th>Price Per Night</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var room in Model)
            {
                <tr>
                    <td>@room.RoomNumber</td>
                    <td>@room.BedType</td>
                    <td>$@room.PricePerNight</td>
                    <td>
                        @if(room.IsAvailable)
                        {
                            <span class="badge bg-success">Available</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Booked</span>
                        }
                    </td>
                    <td>
                        <!-- buttons with the target ID attached! -->
                        <a asp-action="Edit" asp-route-id="@room.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@room.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>