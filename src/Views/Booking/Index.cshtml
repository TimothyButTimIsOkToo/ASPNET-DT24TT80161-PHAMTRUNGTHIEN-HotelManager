@model IEnumerable<HotelManager.Models.Booking>

@{
    ViewData["Title"] = "All Bookings";
}

<div class="container mt-4">
    <h2>Hotel Reservations Dashboard</h2>
    <p>Here is a list of all current customer bookings in the database.</p>

    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>Customer Name</th>
                <th>Room Number</th>
                <th>Check-In Date</th>
                <th>Check-Out Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td class="fw-bold">@booking.CustomerName</td>
                    <!-- access the Room number because of the .Include() we added! -->
                    <td>Room @booking.Room?.RoomNumber</td>
                    <td>@booking.CheckInDate.ToShortDateString()</td>
                    <td>@booking.CheckOutDate.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
    
    @if (!Model.Any())
    {
        <div class="alert alert-info mt-3">No bookings found in the database.</div>
    }
</div>