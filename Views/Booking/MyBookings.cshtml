@model IEnumerable<HotelManager.Models.Booking>

@{
    ViewData["Title"] = "My Bookings";
}

<div class="container mt-4">
    <h2>My Reservations</h2>
    <p>Welcome back! Here are your upcoming stays with us.</p>

    <table class="table table-striped table-bordered mt-3">
        <thead class="table-primary">
            <tr>
                <th>Guest Name</th>
                <th>Room Number</th>
                <th>Check-In Date</th>
                <th>Check-Out Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td class="fw-bold">@booking.CustomerName</td>
                    <td>Room @booking.Room?.RoomNumber</td>
                    <td>@booking.CheckInDate.ToShortDateString()</td>
                    <td>@booking.CheckOutDate.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
    
    @if (!Model.Any())
    {
        <div class="alert alert-info mt-3">You have no upcoming reservations. Head to the Home page to book a room!</div>
    }
</div>