@model HotelManager.Models.Room

@{
    ViewData["Title"] = "Delete Room";
}

<div class="container mt-4">
    <h2 class="text-danger">Delete Room</h2>
    <h3>Are you sure you want to delete this room?</h3>
    <p class="text-muted">This action cannot be undone.</p>
    <hr />
    
    <div>
        <!-- Display the details of the room they are about to delete -->
        <dl class="row">
            <dt class="col-sm-2">Room Number</dt>
            <dd class="col-sm-10">@Model.RoomNumber</dd>

            <dt class="col-sm-2">Bed Type</dt>
            <dd class="col-sm-10">@Model.BedType</dd>

            <dt class="col-sm-2">Price Per Night</dt>
            <dd class="col-sm-10">$@Model.PricePerNight</dd>

            <dt class="col-sm-2">Status</dt>
            <dd class="col-sm-10">
                @(Model.IsAvailable ? "Available" : "Booked")
            </dd>
        </dl>
        
        <form asp-action="Delete">
            <!-- Hide the ID  -->
            <input type="hidden" asp-for="Id" />
            
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>